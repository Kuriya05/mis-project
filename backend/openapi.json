  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "csmju_study_qa_access_token"
      }
    },
    "schemas": {
      "CreateTagSuggestionDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          }
        }
      },
      "CreateQuestionDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          },
          "tags": {
            "description": "Omitted or empty = the server suggests tags from the title and body.",
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            }
          }
        },
        "required": [
          "title",
          "body"
        ]
      },
      "UpdateQuestionDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          },
          "tags": {
            "description": "Replaces the whole tag list; an empty list removes every tag.",
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            }
          }
        }
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 10000
          },
          "parentId": {
            "type": "string",
            "description": "Set = a reply to that answer. Only the question's author may reply.",
            "format": "uuid"
          }
        },
        "required": [
          "body"
        ]
      },
      "UpdateCommentDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "body"
        ]
      }
    }
  }
