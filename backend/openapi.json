    "/auth/login": {
      "get": {
        "operationId": "SsoCallbackController_login",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Starts a sign-in: mints a single-use state, keeps it (with the page to\nreturn to) in a cookie only the callback receives, and sends the browser\nto Core Hub's web app, which signs the user in or renews their session.\n\nNo callback_url is sent: Core Hub only ever redirects to the one in its\nregistry, and refuses a different one with 400.",
        "tags": [
          "SsoCallback"
        ]
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "SsoCallbackController_callback",
        "parameters": [
          {
            "name": "access_token",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token_type",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Bearer",
                "bearer"
              ]
            }
          },
          {
            "name": "expires_in",
            "required": false,
            "in": "query",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": false,
            "in": "query",
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Where Core Hub sends the browser with a token. Three outcomes (SSO spec D3):\n\n - no `state`: Core Hub started this sign-in itself, e.g. a sidebar click.\n   The token is dropped unused and the browser restarts at /auth/login,\n   which comes back here with a state this subsystem can check. A link\n   carrying an attacker's token therefore signs the victim in as the\n   victim, never as the attacker.\n - a `state` that does not match the cookie: 401, and no redirect - if\n   the browser refuses cookies, redirecting again would loop forever.\n - a matching state and a valid token: the token becomes the session\n   cookie and the browser goes to the page it started from.\n\nThe URL carries the access token, so it is never logged - only the path.",
        "tags": [
          "SsoCallback"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "SsoCallbackController_logout",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Signs out everywhere (SSO spec D8). Dropping only this subsystem's cookie\nwould be undone by the next click, which Core Hub - still signed in -\nwould answer with a fresh token. So the browser goes on to Core Hub's\n/logout, where the user confirms ending the Core Hub session.\n\nPublic on purpose: it must work with an expired or missing session, and\nall it does is clear this subsystem's own cookies.",
        "tags": [
          "SsoCallback"
        ]
      }
    },
