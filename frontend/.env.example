# Backend (NestJS) of this subsystem — next.config.ts passes /api/*, /auth/login,
# /auth/callback and /auth/logout on to it. Use your team's backend port (42xx).
BACKEND_URL=http://127.0.0.1:4235
# ต้องตรงกับชื่อในทะเบียน Core Hub และ SUBSYSTEM_ID ของ backend (ใช้ตั้งชื่อคุกกี้ session)
SUBSYSTEM_ID=csmju-study-qa

# คัดลอกเป็น frontend/.env.local (ไม่ขึ้น git) แล้วใส่ค่าจริง
# ผู้ช่วย AI (Gemini) — app/assistant/*: อ่านฝั่ง server เท่านั้น ห้ามตั้งเป็น NEXT_PUBLIC_* ห้าม commit ค่าจริง
# เว้นว่าง = บอทตอบเฉพาะหัวข้อที่มีคำตอบเตรียมไว้
GEMINI_API_KEY=
# ลองตามลำดับ: รุ่นแรกคนใช้เยอะ (429/503) หรือหมดอายุ (404) ใช้รุ่นถัดไป
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest

# host อื่นนอกจาก localhost ที่เปิด dev server ได้ (คั่นด้วยจุลภาค) เช่น IP ของ VPN
DEV_ALLOWED_ORIGINS=
